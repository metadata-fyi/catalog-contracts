{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "entityId",
    "sourceUrl",
    "creator",
    "license",
    "licenseUrl",
    "attribution",
    "permissionEvidence",
    "acquiredAt",
    "sha256",
    "width",
    "height",
    "redistributionApproved"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "entityId": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "creator": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "licenseUrl": {
      "type": "string",
      "format": "uri"
    },
    "attribution": {
      "type": "string"
    },
    "permissionEvidence": {
      "type": "string",
      "minLength": 1
    },
    "acquiredAt": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "redistributionApproved": {
      "const": true
    }
  }
}
